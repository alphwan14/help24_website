# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
# Two of them: `next dev` builds into .next-dev and the production pipeline
# into .next, so neither can overwrite the other's chunks. See the note on
# `distDir` in next.config.mjs for the error that used to cause.
/.next/
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
#
# `.env*.local` alone is the Next.js starter default, and it leaves a real hole:
# a plain `.env` or `.env.production` is NOT matched by it, so the one file most
# likely to hold a key would be committed by `git add .` without a word. The
# parent repository ignores these globally, but this is a SEPARATE repository
# with its own remote — none of that applies here.
#
# `.env.example` stays committable: it is the template, and it must carry
# placeholders only.
.env
.env.*
!.env.example

# vercel
.vercel

# ide
.idea/
*.iml
.vscode/

# typescript
*.tsbuildinfo
